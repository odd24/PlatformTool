<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/fpsValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/value_background"
        android:gravity="center"
        android:padding="14dp"
        android:text="请选择画面后点击开始测量"
        android:textColor="@color/green_700"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fpsDisplayInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/fpsSceneSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/fpsStaticScene"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="静态画面" />

        <RadioButton
            android:id="@+id/fpsDynamicScene"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="动态画面" />
    </RadioGroup>

    <TextView
        android:id="@+id/fpsSceneHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="点击后静置1秒，再在界面完全不变的状态下测量3秒。"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/fpsMeasureButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="开始测量（静置1秒 + 测量3秒）" />

    <com.example.platformtool.FpsSceneView
        android:id="@+id/fpsSceneView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:contentDescription="FPS 测试画面" />

</LinearLayout>
