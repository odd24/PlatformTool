<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/home_heading" android:textColor="@color/text_primary"
            android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginBottom="24dp"
            android:text="@string/home_subtitle"
            android:textColor="@color/text_secondary" android:textSize="15sp" />

        <LinearLayout android:id="@+id/audioCard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:background="@drawable/card_background"
            android:clickable="true" android:elevation="2dp" android:focusable="true" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/tool_audio_title" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/tool_audio_description" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <Button android:id="@+id/openAudioButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:layout_marginTop="8dp" android:text="@string/tool_audio_action" />
        </LinearLayout>

        <LinearLayout android:id="@+id/videoCard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card_background"
            android:clickable="true" android:elevation="2dp" android:focusable="true" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/tool_video_title" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/tool_video_description" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <Button android:id="@+id/openVideoButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:layout_marginTop="8dp" android:text="@string/tool_video_action" />
        </LinearLayout>

        <LinearLayout android:id="@+id/sensorCard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card_background"
            android:clickable="true" android:elevation="2dp" android:focusable="true" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/tool_sensor_title" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/tool_sensor_description" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <Button android:id="@+id/openSensorButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:layout_marginTop="8dp" android:text="@string/tool_sensor_action" />
        </LinearLayout>

        <LinearLayout android:id="@+id/serialCard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card_background"
            android:clickable="true" android:elevation="2dp" android:focusable="true" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/tool_serial_title" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/tool_serial_description" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <Button android:id="@+id/openSerialButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:layout_marginTop="8dp" android:text="@string/tool_serial_action" />
        </LinearLayout>

        <LinearLayout android:id="@+id/logCard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card_background"
            android:clickable="true" android:elevation="2dp" android:focusable="true" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/tool_log_title" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/tool_log_description" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <Button android:id="@+id/openLogButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:layout_marginTop="8dp" android:text="@string/tool_log_action" />
        </LinearLayout>

        <LinearLayout android:id="@+id/fpsCard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card_background"
            android:clickable="true" android:elevation="2dp" android:focusable="true" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/tool_fps_title" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/tool_fps_description" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <Button android:id="@+id/openFpsButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:layout_marginTop="8dp" android:text="@string/tool_fps_action" />
        </LinearLayout>

        <LinearLayout android:id="@+id/quickToolsCard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card_background"
            android:clickable="true" android:elevation="2dp" android:focusable="true" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/quick_tools_title" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/quick_tools_description" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <Button android:id="@+id/openQuickToolsButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:layout_marginTop="8dp" android:text="@string/tool_quick_tools_action" />
        </LinearLayout>

        <LinearLayout android:id="@+id/batteryCard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card_background"
            android:clickable="true" android:elevation="2dp" android:focusable="true" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/tool_battery_title" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/tool_battery_description" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <Button android:id="@+id/openBatteryButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:layout_marginTop="8dp" android:text="@string/tool_battery_action" />
        </LinearLayout>

        <LinearLayout android:id="@+id/consoleCard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/card_background"
            android:clickable="true" android:elevation="2dp" android:focusable="true" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/tool_console_title" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/tool_console_description" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <Button android:id="@+id/openConsoleButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:layout_marginTop="8dp" android:text="@string/tool_console_action" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
