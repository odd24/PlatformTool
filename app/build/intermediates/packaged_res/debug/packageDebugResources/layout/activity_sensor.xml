<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/sensorStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/value_background"
            android:text="正在检测设备传感器…"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="加速度计" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <Switch android:id="@+id/accelerometerSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:showText="true" android:textOff="关闭" android:textOn="开启" />
            </LinearLayout>
            <TextView android:id="@+id/accelerometerValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/value_background" android:fontFamily="monospace" android:text="等待数据" android:textColor="@color/text_primary" android:textIsSelectable="true" />
            <com.example.platformtool.GravityBallView
                android:id="@+id/gravityBallView"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="10dp"
                android:contentDescription="加速度计方向测试滚动小球" />
            <TextView android:id="@+id/accelerometerInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/card_background" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="陀螺仪" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <Switch android:id="@+id/gyroscopeSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:showText="true" android:textOff="关闭" android:textOn="开启" />
            </LinearLayout>
            <TextView android:id="@+id/gyroscopeValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/value_background" android:fontFamily="monospace" android:text="等待数据" android:textColor="@color/text_primary" android:textIsSelectable="true" />
            <TextView android:id="@+id/gyroscopeInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/card_background" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="地磁传感器" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <Switch android:id="@+id/magneticSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:showText="true" android:textOff="关闭" android:textOn="开启" />
            </LinearLayout>
            <TextView android:id="@+id/magneticValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/value_background" android:fontFamily="monospace" android:text="等待数据" android:textColor="@color/text_primary" android:textIsSelectable="true" />
            <TextView android:id="@+id/magneticInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/card_background" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="环境光传感器" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <Switch android:id="@+id/lightSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:showText="true" android:textOff="关闭" android:textOn="开启" />
            </LinearLayout>
            <TextView android:id="@+id/lightValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/value_background" android:fontFamily="monospace" android:text="等待数据" android:textColor="@color/text_primary" android:textIsSelectable="true" />
            <TextView android:id="@+id/lightInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="18dp" android:background="@drawable/card_background" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="距离传感器" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <Switch android:id="@+id/proximitySwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:showText="true" android:textOff="关闭" android:textOn="开启" />
            </LinearLayout>
            <TextView android:id="@+id/proximityValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/value_background" android:fontFamily="monospace" android:text="等待数据" android:textColor="@color/text_primary" android:textIsSelectable="true" />
            <TextView android:id="@+id/proximityInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
